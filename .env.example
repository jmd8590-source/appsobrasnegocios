# ============================================
# ScrapLens — Variables de entorno
# ============================================
# Copia este archivo como .env.local y rellena los valores

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Gemini AI ---
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# CRON_SECRET=optional-bearer-secret-for-api-keepalive

# NEXT_PUBLIC_DEMO_MODE is no longer read anywhere in the code — leaving it
# set to "true" here used to silently force EVERY visitor (including a
# real, successfully registered account) into the shared demo/local
# experience, even after NEXT_PUBLIC_SUPABASE_URL/ANON_KEY above were
# filled in correctly. Whether someone is on the demo now depends only on
# whether Supabase has real credentials configured and whether that
# specific visitor is actually signed in — not on this flag. It's listed
# here only so anyone who had it set in an old .env.local knows it can be
# deleted; it does nothing.

# --- Cloudflare (solo para deploy) ---
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
