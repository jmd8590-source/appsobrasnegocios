# ============================================
# ScrapLens — Variables de entorno
# ============================================
# Copia este archivo como .env.local y rellena los valores

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Gemini AI ---
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true  # Set to false when Gemini + Supabase are configured

# --- Cloudflare (solo para deploy) ---
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
